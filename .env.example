NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Genius API — get a free token at https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=your_genius_access_token

# Anthropic — used for OCR lyrics extraction from images
ANTHROPIC_API_KEY=your_anthropic_api_key

# Bible API — get a free key at https://scripture.api.bible
BIBLE_API_KEY=your_bible_api_key
BIBLE_ID=your_bible_id   # e.g. 78a9f6124f344018-01
